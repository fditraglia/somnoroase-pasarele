{
  "phrases": {
    "notMine": { "ro": "Ăsta nu-i cuibul meu!", "en": "This isn't my nest!" },
    "goodNight": { "ro": "Noapte bună!", "en": "Good night!" },
    "sleepWell": { "ro": "Somn ușor!", "en": "Sleep well!" },
    "tryAgain": { "ro": "Mai încearcă!", "en": "Try again!" },
    "congrats": { "ro": "Felicitări!", "en": "Congratulations!" }
  },
  "poem": {
    "title": "Somnoroase păsărele",
    "author": "Mihai Eminescu",
    "stanzas": [
      {
        "ro": ["Somnoroase păsărele", "Pe la cuiburi se adună,", "Se ascund în rămurele —", "Noapte bună!"],
        "en": ["Sleepy little birds", "gather at their nests,", "and hide among the little branches —", "good night!"]
      },
      {
        "ro": ["Doar izvoarele suspină,", "Pe când codrul negru tace;", "Dorm și florile-n grădină —", "Dormi în pace!"],
        "en": ["Only the springs are sighing,", "while the dark forest falls silent;", "the flowers in the garden sleep too —", "sleep in peace!"]
      },
      {
        "ro": ["Trece lebăda pe ape", "Între trestii să se culce —", "Fie-ți îngerii aproape,", "Somnul dulce!"],
        "en": ["The swan glides over the water", "to lie down among the reeds —", "may the angels be near you,", "and your sleep be sweet!"]
      },
      {
        "ro": ["Peste-a nopții feerie", "Se ridică mândra lună,", "Totu-i vis și armonie —", "Noapte bună!"],
        "en": ["Over the enchantment of the night", "the proud moon rises;", "all is dream and harmony —", "good night!"]
      }
    ]
  }
}
