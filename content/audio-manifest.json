 },
 {
  "hash": "34cc9a82aa100b38",
  "text": "card"
 },
 {
  "hash": "70fa7679c74aaa65",
  "text": "un card, două carduri"
 },
 {
  "hash": "16d283bc97681788",
  "text": "Unde este cardul?"
 },
 {
  "hash": "a7f00b3c01634539",
  "text": "inel"
 },
 {
  "hash": "6d6c984b2e66abda",
  "text": "un inel, două inele"
 },
 {
  "hash": "596b6cfd23aa975e",
  "text": "Unde este inelul?"
 },
 {
  "hash": "cd5fc03db9786b93",
  "text": "Ăsta nu-i cuibul meu!"
 },
 {
  "hash": "0cc8518d192fa299",
  "text": "Noapte bună!"
 },
 {
  "hash": "cb73b6dacd18ed11",
  "text": "Somn ușor!"
 },
 {
  "hash": "3ffef23f461e2c9c",
  "text": "Mai încearcă!"
 },
 {
  "hash": "4d5b312ca9a81a17",
  "text": "Felicitări!"
 },
 {
  "hash": "40251e3a7ed9b7f8",
  "text": "Somnoroase păsărele\nPe la cuiburi se adună,\nSe ascund în rămurele —\nNoapte bună!"
 },
 {
  "hash": "7e0d74cd5fec0da5",
  "text": "Doar izvoarele suspină,\nPe când codrul negru tace;\nDorm și florile-n grădină —\nDormi în pace!"
 },
 {
  "hash": "88164c994585570b",
  "text": "Trece lebăda pe ape\nÎntre trestii să se culce —\nFie-ți îngerii aproape,\nSomnul dulce!"
 },
 {
  "hash": "dc63c055c20fdd62",
  "text": "Peste-a nopții feerie\nSe ridică mândra lună,\nTotu-i vis și armonie —\nNoapte bună!"
 }
]
